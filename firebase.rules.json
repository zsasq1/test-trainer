{
  "rules": {
    ".read": false,
    ".write": false,
    "online": {
      ".read": true,
      "$sid": {
        ".write": "$sid.length >= 8 && $sid.length <= 40",
        ".validate": "newData.isNumber() && newData.val() <= now + 60000"
      }
    },
    "days": {
      ".read": true,
      "$day": {
        ".validate": "$day.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
        "$vid": {
          ".write": "$vid.length >= 8 && $vid.length <= 40",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "live": {
      ".read": "auth != null && auth.uid === '9PzGNx8jvqYVoQri3ZaoRrPlyQC3'",
      "$sid": {
        ".write": "$sid.length >= 8 && $sid.length <= 40",
        ".validate": "newData.hasChildren(['t']) && (!newData.child('u').exists() || (auth != null && newData.child('u').val() === auth.uid))",
        "t": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "s": { ".validate": "newData.isNumber()" },
        "v": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "d": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "w": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "u": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    "logins": {
      "$key": {
        ".read": true,
        ".write": "auth != null && (auth.uid === '9PzGNx8jvqYVoQri3ZaoRrPlyQC3' || (!data.exists() && newData.parent().parent().child('users').child(auth.uid).child('key').val() === $key) || (data.exists() && !newData.exists() && (data.val() + '@users.example.com' === auth.token.email || data.val() === 'g:' + auth.uid) && newData.parent().parent().child('users').child(auth.uid).child('key').val() !== $key))",
        ".validate": "newData.isString() && (newData.val() + '@users.example.com' === auth.token.email || newData.val() === 'g:' + auth.uid) && $key.length >= 3 && $key.length <= 24"
      }
    },
    "users": {
      ".read": "auth != null && auth.uid === '9PzGNx8jvqYVoQri3ZaoRrPlyQC3'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === '9PzGNx8jvqYVoQri3ZaoRrPlyQC3'",
        ".validate": "newData.hasChildren(['name', 'key', 'login', 'renamed'])",
        "name": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && data.parent().child('blocked').val() !== true && (!data.exists() || (data.parent().child('renamed').val() === false && newData.parent().child('renamed').val() === true))",
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 24 && newData.val().toLowerCase().replace('ё', 'е') === newData.parent().child('key').val()"
        },
        "key": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && data.parent().child('blocked').val() !== true && (!data.exists() || (data.parent().child('renamed').val() === false && newData.parent().child('renamed').val() === true))",
          ".validate": "newData.isString() && newData.parent().parent().parent().child('logins').child(newData.val()).val() === newData.parent().child('login').val() && (!data.exists() || data.val() === newData.val() || !newData.parent().parent().parent().child('logins').child(data.val()).exists())"
        },
        "login": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isString() && (newData.val() + '@users.example.com' === auth.token.email || newData.val() === 'g:' + auth.uid)"
        },
        "renamed": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && data.parent().child('blocked').val() !== true && (!data.exists() || data.val() === false)",
          ".validate": "newData.isBoolean() && (data.exists() || newData.val() === false)"
        },
        "course": {
          ".write": "auth != null && auth.uid === $uid && data.parent().child('blocked').val() !== true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
        },
        "created": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "last": {
          ".write": "auth != null && auth.uid === $uid && data.parent().child('blocked').val() !== true",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "d": {
          ".write": "auth != null && auth.uid === $uid && data.parent().child('blocked').val() !== true",
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "blocked": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
